# Local development image. Source is bind-mounted by docker-compose.yml;
# this build mainly exists to get node_modules installed into the image/volume.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000
ENV NEXT_TELEMETRY_DISABLED=1
CMD ["npm", "run", "dev"]
